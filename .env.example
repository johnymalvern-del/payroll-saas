# =====================================================================
# DEVELOPMENT / EXAMPLE ONLY - DO NOT USE THESE VALUES IN PRODUCTION
# Copy to .env and replace every secret before any real deployment.
# =====================================================================

ENVIRONMENT=development
SECRET_KEY=dev-only-secret-key-must-be-at-least-32-bytes-long-ABCDEF
MASTER_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

DATABASE_URL_CONTROL=postgresql+psycopg://payroll_app:payroll_app_dev_password@postgres:5432/payroll_control
DATABASE_URL_CONTROL_ADMIN=postgresql+psycopg://payroll_admin:payroll_admin_dev_password@postgres:5432/payroll_control
DATABASE_URL_TENANT_TEMPLATE=postgresql+psycopg://payroll_app:payroll_app_dev_password@postgres:5432/{tenant_db}
DATABASE_URL_TENANT_ADMIN_TEMPLATE=postgresql+psycopg://payroll_admin:payroll_admin_dev_password@postgres:5432/{tenant_db}

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=payroll-files
S3_REGION=us-east-1

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO

# Only respected when ENVIRONMENT is development or test.
# Setting this to true in production fails application startup.
ALLOW_TENANT_HEADER_FALLBACK=true